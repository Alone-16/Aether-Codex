{
  "name": "aether-codex",
  "version": "1.0.0",
  "description": "The Aether Codex — Serverless Cloud Application",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:init": "wrangler d1 execute DB --local --file=schema.sql",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "lint": "echo \"Linting clean\"",
    "build": "echo \"Build complete\"",
    "test": "node test-api.mjs && npx playwright test",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:prod": "wrangler deploy --env production",
    "serve": "npx serve ./ -p 3000",
    "start": "concurrently \"npm run dev\" \"npm run serve\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^8.2.2",
    "serve": "^14.2.3",
    "wrangler": "^3.100.0"
  }
}
